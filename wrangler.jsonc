{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rapier-workspace",
  "main": "src/workspace/worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "RAPIER_DEPLOYMENT" },
  "rules": [
    { "type": "Data", "globs": ["**/*.asset"], "fallthrough": true }
  ],
  "r2_buckets": [
    { "binding": "BUCKET" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FILES", "class_name": "WorkspaceFiles" },
      { "name": "DOCUMENTS", "class_name": "RapierDocument" },
      { "name": "BUDGET", "class_name": "RapierBudget" }
    ]
  },
  "exports": {
    "WorkspaceFiles": { "type": "durable-object", "storage": "sqlite" },
    "RapierDocument": { "type": "durable-object", "storage": "sqlite" },
    "RapierBudget": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": false }
}
